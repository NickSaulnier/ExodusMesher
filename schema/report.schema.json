{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "description": "The complete `report.json`.",
  "type": "object",
  "properties": {
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attempt"
      }
    },
    "config": {
      "$ref": "#/$defs/JobConfig"
    },
    "input": {
      "$ref": "#/$defs/InputInfo"
    },
    "parts": {
      "description": "Parts found by diagnosis, in index order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartSummary"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "stages_run": {
      "description": "Stages that ran, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stage"
      }
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    }
  },
  "required": [
    "schema_version",
    "tool",
    "input",
    "config",
    "stages_run",
    "records",
    "attempts",
    "summary"
  ],
  "$defs": {
    "Action": {
      "description": "What was done about a finding.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "skip_line",
            "drop_face",
            "fan_triangulate",
            "remesh",
            "merge",
            "remove",
            "fill_hole",
            "split_edge",
            "duplicate_vertex",
            "reorient",
            "flip",
            "truncate",
            "fallback",
            "abort"
          ]
        },
        {
          "description": "A tet rounding turned over, fixed by moving a constructed vertex\nwithin its rounding or by a flip.",
          "type": "string",
          "const": "untangle"
        }
      ]
    },
    "Attempt": {
      "description": "One meshing attempt, in the order tried.",
      "type": "object",
      "properties": {
        "kernel": {
          "$ref": "#/$defs/Kernel"
        },
        "outcome": {
          "$ref": "#/$defs/AttemptOutcome"
        },
        "part": {
          "type": [
            "string",
            "null"
          ]
        },
        "remeshed": {
          "description": "The attempt meshed the remeshed surface, not the repaired one.",
          "type": "boolean"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": [
        "kernel",
        "outcome"
      ]
    },
    "AttemptOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "CodeCount": {
      "description": "Per-code totals in the summary.",
      "type": "object",
      "properties": {
        "reported": {
          "description": "Occurrences with a detailed record in `records`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "description": "Every occurrence found.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "reported"
      ]
    },
    "DefectCode": {
      "description": "Stable defect codes. Serialized as `SCREAMING_SNAKE_CASE` strings.",
      "oneOf": [
        {
          "description": "Malformed or non-numeric OBJ line",
          "type": "string",
          "const": "PARSE_BAD_LINE"
        },
        {
          "description": "Face references a missing vertex",
          "type": "string",
          "const": "PARSE_BAD_INDEX"
        },
        {
          "description": "Input file cannot be opened or read",
          "type": "string",
          "const": "PARSE_READ_FAILED"
        },
        {
          "description": "Project file cannot be read or is not a valid project",
          "type": "string",
          "const": "PARSE_PROJECT_INVALID"
        },
        {
          "description": "No faces survive parsing",
          "type": "string",
          "const": "PARSE_NO_GEOMETRY"
        },
        {
          "description": "Lines, points, curves or surfaces in the OBJ file",
          "type": "string",
          "const": "PARSE_UNSUPPORTED_ELEMENT"
        },
        {
          "description": "Polygon could not be ear-clipped and was fan-triangulated",
          "type": "string",
          "const": "PARSE_POLYGON_FALLBACK"
        },
        {
          "description": "No parts selected, or a named part does not exist",
          "type": "string",
          "const": "PART_EMPTY_SELECTION"
        },
        {
          "description": "Two selected parts intersect",
          "type": "string",
          "const": "PART_OVERLAP"
        },
        {
          "description": "Two selected parts touch along a surface",
          "type": "string",
          "const": "PART_SHARED_INTERFACE"
        },
        {
          "description": "Vertices closer than tolerance",
          "type": "string",
          "const": "GEO_DUPLICATE_VERTEX"
        },
        {
          "description": "Zero-area or collinear face",
          "type": "string",
          "const": "GEO_DEGENERATE_FACE"
        },
        {
          "description": "Same face listed twice",
          "type": "string",
          "const": "GEO_DUPLICATE_FACE"
        },
        {
          "description": "Hole: edge with one adjacent face",
          "type": "string",
          "const": "TOP_BOUNDARY_EDGE"
        },
        {
          "description": "Edge shared by three or more faces",
          "type": "string",
          "const": "TOP_NONMANIFOLD_EDGE"
        },
        {
          "description": "Vertex joining separate fans",
          "type": "string",
          "const": "TOP_NONMANIFOLD_VERTEX"
        },
        {
          "description": "Neighbouring faces disagree on winding",
          "type": "string",
          "const": "TOP_INCONSISTENT_ORIENTATION"
        },
        {
          "description": "Shell with negative signed volume",
          "type": "string",
          "const": "TOP_INVERTED_SHELL"
        },
        {
          "description": "Surface encloses no volume",
          "type": "string",
          "const": "TOP_OPEN_SHEET"
        },
        {
          "description": "Faces of one shell intersect",
          "type": "string",
          "const": "INT_SELF_INTERSECTION"
        },
        {
          "description": "Two shells of one part intersect",
          "type": "string",
          "const": "INT_SHELL_OVERLAP"
        },
        {
          "description": "Minimum angle below threshold",
          "type": "string",
          "const": "QUAL_SLIVER_FACE"
        },
        {
          "description": "Bounding box suggests wrong units",
          "type": "string",
          "const": "QUAL_SUSPECT_SCALE"
        },
        {
          "description": "Constrained Delaunay could not recover a facet",
          "type": "string",
          "const": "MESH_RECOVERY_FAILED"
        },
        {
          "description": "Steiner-point or element budget hit",
          "type": "string",
          "const": "MESH_BUDGET_EXCEEDED"
        },
        {
          "description": "Part too large for 32-bit vertex and face indices",
          "type": "string",
          "const": "GEO_CAPACITY_EXCEEDED"
        },
        {
          "description": "A repair changed the shell count or enclosed volume beyond its limit",
          "type": "string",
          "const": "REPAIR_GUARD_EXCEEDED"
        },
        {
          "description": "--strict was given but no conformal mesh could be produced",
          "type": "string",
          "const": "MESH_STRICT_UNMET"
        },
        {
          "description": "Worker panicked, timed out or ran out of memory",
          "type": "string",
          "const": "MESH_WORKER_FAILED"
        },
        {
          "description": "A tet that rounding to f64 turned over or flattened was untangled",
          "type": "string",
          "const": "MESH_ROUNDING_REPAIRED"
        },
        {
          "description": "Tets that rounding to f64 turned over or flattened could not be untangled",
          "type": "string",
          "const": "MESH_ROUNDING_FAILED"
        },
        {
          "description": "Tetrahedron with non-positive volume",
          "type": "string",
          "const": "VOL_INVERTED_TET"
        },
        {
          "description": "Non-orthogonality, skewness or volume ratio out of bounds",
          "type": "string",
          "const": "VOL_LOW_QUALITY"
        },
        {
          "description": "Hausdorff distance to input over tolerance",
          "type": "string",
          "const": "VOL_BOUNDARY_DEVIATION"
        },
        {
          "description": "Part or set name over the Exodus limit",
          "type": "string",
          "const": "EXO_NAME_TRUNCATED"
        },
        {
          "description": "Mesh too large for the 64-bit-offset format",
          "type": "string",
          "const": "EXO_CAPACITY_EXCEEDED"
        },
        {
          "description": "An output file could not be written",
          "type": "string",
          "const": "OUT_WRITE_FAILED"
        }
      ]
    },
    "InputInfo": {
      "type": "object",
      "properties": {
        "path": {
          "description": "The input path exactly as given.",
          "type": "string"
        },
        "stats": {
          "description": "Absent when the file could not be read.",
          "anyOf": [
            {
              "$ref": "#/$defs/InputStats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path"
      ]
    },
    "InputStats": {
      "description": "What the parser found in the input.",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "groups": {
          "description": "`g` names in order of first appearance.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lines": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "objects": {
          "description": "`o` names in order of first appearance.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "polygons": {
          "description": "Faces as written in the file (polygons of any size).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "triangles": {
          "description": "Triangles after triangulating the polygons.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vertices": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "bytes",
        "lines",
        "vertices",
        "polygons",
        "triangles"
      ]
    },
    "JobConfig": {
      "description": "User-facing job settings (the policy flags). Recorded in the report.",
      "type": "object",
      "properties": {
        "element_size": {
          "description": "Target element size (the stuffing lattice spacing), relative to the\npart's bounding-box diagonal.",
          "type": "number",
          "format": "double",
          "default": 0.03
        },
        "kernel": {
          "description": "The volume kernel tried first.",
          "$ref": "#/$defs/KernelChoice"
        },
        "max_deviation": {
          "description": "Largest acceptable fallback deviation, relative to the part's bounding-box diagonal.",
          "type": "number",
          "format": "double",
          "default": 0.05
        },
        "no_remesh": {
          "description": "When the conformal mesh of a part fails, do not remesh its surface\nand retry before the stuffing fallback.",
          "type": "boolean"
        },
        "no_repair": {
          "description": "Diagnose and report only.",
          "type": "boolean",
          "default": false
        },
        "parts": {
          "description": "Names or indices of the parts to mesh; empty means all.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "strict": {
          "description": "Conformal paths only; never use the stuffing fallback.",
          "type": "boolean",
          "default": false
        },
        "stuffing_only": {
          "description": "Skip the conformal kernel and mesh with stuffing only. Set by the\nclient when a worker running the conformal kernel timed out or ran out\nof memory, for its one retry (`MESH_WORKER_FAILED`, fallback).",
          "type": "boolean"
        },
        "uniform_size": {
          "description": "Mesh at `element_size` everywhere, without the sizing field (which\ngrades the size down to a quarter of it where the surface is curved\nor the part is thin).",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Kernel": {
      "description": "Volume kernel used by a meshing attempt.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "delaunay",
            "stuffing"
          ]
        },
        {
          "description": "The exact constrained Delaunay kernel, rounded to f64.",
          "type": "string",
          "const": "exact"
        }
      ]
    },
    "KernelChoice": {
      "description": "The volume kernel tried first; the rest of the fallback ladder follows it.",
      "oneOf": [
        {
          "description": "The conforming Delaunay kernel, refined to the element size.",
          "type": "string",
          "const": "conformal"
        },
        {
          "description": "The exact constrained Delaunay kernel (`--kernel exact`): the input\nsurface tetrahedralized exactly, then rounded to f64, without\nrefinement; the conforming kernel and stuffing follow if it fails.",
          "type": "string",
          "const": "exact"
        }
      ]
    },
    "Location": {
      "description": "Where a finding is. `vertices` are 0-based indices into the parsed vertex\nlist and `faces` are 0-based indices into the triangulated face list (a\npolygon with n corners becomes n - 2 consecutive triangles); `obj_lines` are\n1-based line numbers in the input file. Each list holds at most\n[`MAX_LOCATION_ITEMS`] entries; a truncated list has its full length in the\nrecord's `measured` map (`vertices_total`, `faces_total`, `obj_lines_total`).",
      "type": "object",
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "obj_lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "point": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      }
    },
    "MeshSummary": {
      "description": "The volume mesh of one part and its quality.",
      "type": "object",
      "properties": {
        "accepted": {
          "description": "Whether the mesh passed the volume gate and was written.",
          "type": "boolean"
        },
        "dihedral_histogram": {
          "description": "Every dihedral angle (six per tet) in 10° bins from [0°, 10°) to [170°, 180°].",
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "element_size": {
          "description": "Element size used (absolute): the largest target size.",
          "type": "number",
          "format": "double"
        },
        "hausdorff": {
          "description": "Two-sided Hausdorff distance between the input surface and the mesh\nboundary (sampled at vertices and face centroids), absolute and\nrelative to the part's bounding-box diagonal.",
          "type": "number",
          "format": "double"
        },
        "hausdorff_relative": {
          "type": "number",
          "format": "double"
        },
        "kernel": {
          "$ref": "#/$defs/Kernel"
        },
        "max_dihedral_degrees": {
          "type": "number",
          "format": "double"
        },
        "max_non_orthogonality_degrees": {
          "description": "Finite-volume quality on interior faces: angle between face normal and\ncentroid line, its mean, skewness, and neighbour volume ratio.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "max_skewness": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "max_volume_ratio": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "mean_non_orthogonality_degrees": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "min_dihedral_degrees": {
          "type": "number",
          "format": "double"
        },
        "min_element_size": {
          "description": "Smallest target size (absolute), when the size was graded: the\nsizing field's for a conformal mesh, the surface cell size for graded\nstuffing.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "nodes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remeshed": {
          "description": "The mesh conforms to the remeshed surface, not the repaired one (the\nconformal mesh of the repaired surface failed); its deviation from\nthe repaired surface is `hausdorff`.",
          "type": "boolean"
        },
        "steiner_points": {
          "description": "Points the kernel added (Delaunay: boundary and interior Steiner points).",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "surface_volume": {
          "description": "Signed volume enclosed by the repaired surface (for a surface that\nfailed the gate, overlapping shells count their overlap twice).",
          "type": "number",
          "format": "double"
        },
        "tets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "kernel",
        "accepted",
        "tets",
        "nodes",
        "element_size",
        "volume",
        "surface_volume",
        "min_dihedral_degrees",
        "max_dihedral_degrees",
        "hausdorff",
        "hausdorff_relative"
      ]
    },
    "Outcome": {
      "description": "Result of the action.",
      "oneOf": [
        {
          "description": "The action was carried out.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "The action was attempted and did not succeed.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Left for a later stage to decide.",
          "type": "string",
          "const": "deferred"
        }
      ]
    },
    "PartSource": {
      "description": "How a part was formed.",
      "oneOf": [
        {
          "description": "An `o` statement (faces before any `o` form the part `default`).",
          "type": "string",
          "const": "object"
        },
        {
          "description": "A `g` statement, in a file without `o` statements.",
          "type": "string",
          "const": "group"
        },
        {
          "description": "A connected component, in a file with neither; enclosed cavities join\nthe component that contains them.",
          "type": "string",
          "const": "component"
        }
      ]
    },
    "PartSummary": {
      "description": "One part, as the GUI part tree shows it.",
      "type": "object",
      "properties": {
        "bounds": {
          "description": "Bounding box `[min, max]`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "maxItems": 2,
          "minItems": 2
        },
        "index": {
          "description": "1-based; `--parts` accepts this or the name.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mesh": {
          "description": "Present when a volume mesh was attempted.",
          "anyOf": [
            {
              "$ref": "#/$defs/MeshSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "repair": {
          "description": "Present when the part was repaired.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepairSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "shells": {
          "description": "Edge-connected surface pieces.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/PartSource"
        },
        "triangles": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vertices": {
          "description": "Distinct vertices after merging duplicates.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "name",
        "source",
        "triangles",
        "vertices",
        "shells",
        "bounds",
        "selected"
      ]
    },
    "Record": {
      "description": "One finding.",
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "$ref": "#/$defs/DefectCode"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "measured": {
          "type": "object",
          "additionalProperties": true
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "description": "Part the finding belongs to, once parts exist.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "threshold": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "code",
        "severity",
        "stage"
      ]
    },
    "RepairSummary": {
      "description": "Face and vertex counts through repair, and the surface gate's verdict.",
      "type": "object",
      "properties": {
        "faces_after": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "faces_before": {
          "description": "Triangles in the part as parsed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "gate_passed": {
          "type": "boolean"
        },
        "vertices_after": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vertices_before": {
          "description": "Vertices entering repair (after merging duplicates).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "faces_before",
        "faces_after",
        "vertices_before",
        "vertices_after",
        "gate_passed"
      ]
    },
    "Severity": {
      "oneOf": [
        {
          "description": "Noteworthy, no action needed.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Repaired automatically; output still valid.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Blocks a stage; a fallback may still succeed.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "No usable output possible.",
          "type": "string",
          "const": "fatal"
        }
      ]
    },
    "Stage": {
      "description": "Pipeline stage that produced a record.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "parse",
